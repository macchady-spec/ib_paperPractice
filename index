}
function loadState(){
  // restore last family
  state.famKey = localStorage.getItem(LS_LAST) || "P1-8";
  state.exemplar = localStorage.getItem(LS_EX) === "1";
  const c = localStorage.getItem(LS_CUSTOM+state.famKey);
  state.custom = c ? JSON.parse(c) : null;
  const d = localStorage.getItem(stateKey());
  state.data = d ? JSON.parse(d) : {};
}
function saveState(){
  localStorage.setItem(LS_LAST, state.famKey);
  localStorage.setItem(LS_EX, state.exemplar?"1":"0");
  if(state.custom){
    localStorage.setItem(LS_CUSTOM+state.famKey, JSON.stringify(state.custom));
  }
  localStorage.setItem(stateKey(), JSON.stringify(state.data));
  flashSaved();
}
