function responseToMarkup(response){
  const trimmed = (response||'').trim();
  if(!trimmed) return '';
  return trimmed.split(/\n\s*\n/).map(p=>`<p>${esc(p).replace(/\n/g,'<br>')}</p>`).join('');
}
function escapeRegExp(str){ return (str||'').replace(/[.*+?^${}()|[\]\\]/g,'\\$&'); }
function annotationMarkup(stamp,id,innerHtml){
  return `<span class="inline-annot" data-ann-id="${id}" data-stamp="${stamp}"><span class="annot-core">${innerHtml}</span><span class="inline-badge">${stamp}</span></span>`;
}
function bootstrapAnnotationsFromLegacy(){
  const response = state.data.response || '';
  const legacy = Array.isArray(state.data.emap) ? state.data.emap : [];
  let html = responseToMarkup(response);
  const annotations = [];
  if(!response.trim()){
    state.data.annotatedSource = response;
    state.data.annotatedHtml = '';
    state.data.annotations = [];
    return;
  }
  legacy.forEach((row,idx)=>{
    const id = `ann_${Date.now()}_${idx}`;
    const quote = (row.quote||'').trim();
    annotations.push({id,stamp:row.stamp,text:quote,note:row.note||''});
    if(quote){
      const safeQuote = esc(quote);
      html = html.replace(new RegExp(escapeRegExp(safeQuote)), annotationMarkup(row.stamp,id,safeQuote));
    }
  });
  state.data.annotations = annotations;
  state.data.annotatedSource = response;
  state.data.annotatedHtml = html || responseToMarkup(response);
}
function syncEmapFromAnnotations(){
  const annotations = Array.isArray(state.data.annotations) ? state.data.annotations : [];
  state.data.emap = annotations.map(a=>({stamp:a.stamp,quote:a.text||'',note:a.note||''}));
}
function ensureAnnotationState(){
  state.data.annotations = Array.isArray(state.data.annotations) ? state.data.annotations : [];
  const response = state.data.response || '';
  if(!response.trim()){
    state.data.annotatedSource = '';
    state.data.annotatedHtml = '';
    state.data.annotations = [];
    state.data.emap = [];
    return;
  }
  if(!state.data.annotatedHtml){
    if((state.data.emap||[]).length && !state.data.annotations.length){
      bootstrapAnnotationsFromLegacy();
    } else {
      state.data.annotatedSource = response;
      state.data.annotatedHtml = responseToMarkup(response);
    }
  }
  if(!state.data.annotatedSource) state.data.annotatedSource = response;
  syncEmapFromAnnotations();
}
function annotationSelectionStatus(msg, cls=''){
  const el = $("#annotStatus");
  if(!el) return;
  el.className = `annot-status${cls ? ' '+cls : ''}`;
  el.textContent = msg;
}
function findAnnotAncestor(node){
  if(!node) return null;
  if(node.nodeType===3) node = node.parentNode;
  return node && node.closest ? node.closest('.inline-annot') : null;
}
function syncAnnotatedStateFromDom(){
  const surface = $("#annotatedResponse");
  if(surface) state.data.annotatedHtml = surface.innerHTML;
  syncEmapFromAnnotations();
}
function rebuildAnnotationsFromCurrentResponse(){
  const response = state.data.response || '';
  state.data.annotations = [];
  state.data.annotatedSource = response;
  state.data.annotatedHtml = responseToMarkup(response);
  syncEmapFromAnnotations();
  queueSave();
  renderStep5();
}
function clearAllAnnotations(){
  rebuildAnnotationsFromCurrentResponse();
  annotationSelectionStatus('All annotations cleared. Select text in the response, then click a stamp.');
}
function applyTextAnnotation(stamp){
  const surface = $("#annotatedResponse");
  if(!surface || !surface.innerHTML.trim()){
    annotationSelectionStatus('Write a response in Step 4 first, then come back to annotate it.','err');
    return;
  }
  if((state.data.annotatedSource||'') !== (state.data.response||'')){
    annotationSelectionStatus('Your Step 4 answer changed. Click "Use current Step 4 response" before adding new highlights.','warn');
    return;
  }
  const sel = window.getSelection();
  if(!sel || !sel.rangeCount){
    annotationSelectionStatus('Select text in the response first, then click a stamp.','warn');
    return;
  }
  const range = sel.getRangeAt(0);
  if(range.collapsed || !surface.contains(range.commonAncestorContainer)){
    annotationSelectionStatus('Select text inside the response first, then click a stamp.','warn');
    return;
  }
  if(findAnnotAncestor(range.startContainer) || findAnnotAncestor(range.endContainer)){
    annotationSelectionStatus('That phrase is already inside an annotation. Remove it first if you want to re-tag it.','warn');
    return;
  }
  const selectedText = sel.toString().replace(/\s+/g,' ').trim();
  if(!selectedText){
    annotationSelectionStatus('Select a meaningful phrase, not just blank space.','warn');
    return;
  }
  const id = `ann_${Date.now()}_${Math.random().toString(36).slice(2,7)}`;
  const wrapper = document.createElement('span');
  wrapper.className = 'inline-annot';
  wrapper.dataset.annId = id;
  wrapper.dataset.stamp = stamp;
  const core = document.createElement('span');
  core.className = 'annot-core';
  core.appendChild(range.extractContents());
  const badge = document.createElement('span');
  badge.className = 'inline-badge';
  badge.textContent = stamp;
  wrapper.appendChild(core);
  wrapper.appendChild(badge);
  range.insertNode(wrapper);
  sel.removeAllRanges();
  state.data.annotations.push({id,stamp,text:selectedText,note:''});
  syncAnnotatedStateFromDom();
  queueSave();
  renderAnnotationLog();
  annotationSelectionStatus(`Added ${stamp} to: "${selectedText}"`);
}
function removeAnnotation(id){
  const surface = $("#annotatedResponse");
  const node = surface ? surface.querySelector(`[data-ann-id="${id}"]`) : null;
  if(node){
    const core = node.querySelector('.annot-core');
    while(core && core.firstChild){ node.parentNode.insertBefore(core.firstChild,node); }
    node.remove();
  }
  state.data.annotations = (state.data.annotations||[]).filter(a=>a.id!==id);
  syncAnnotatedStateFromDom();
  queueSave();
  renderAnnotationLog();
  annotationSelectionStatus('Annotation removed.');
}
function renderAnnotationLog(){
  const wrap = $("#annotationLog");
  const summary = $("#annotationSummary");
  if(!wrap || !summary) return;
  const annotations = state.data.annotations || [];
  if(!annotations.length){
    summary.textContent = 'No annotations yet. Select a phrase in the response and click a stamp.';
    wrap.innerHTML = `<div class="annot-log-empty">No highlights yet. This is where stamped phrases and quick notes will appear.</div>`;
    syncEmapFromAnnotations();
    return;
  }
  const counts = {};
  annotations.forEach(a=> counts[a.stamp] = (counts[a.stamp]||0)+1 );
  summary.innerHTML = Object.entries(counts).map(([stamp,count])=>`<span class="tag" style="background:var(--${stampVar(stamp)})">${stamp} × ${count}</span>`).join(' ') + ` <span style="margin-left:6px">${annotations.length} total highlight${annotations.length===1?'':'s'}</span>`;
  wrap.innerHTML = '';
  annotations.forEach((ann,idx)=>{
    const item = el('div',{class:'annot-item'});
    item.innerHTML = `
      <div class="annot-item-head">
        <span class="tag" style="background:var(--${stampVar(ann.stamp)})">${esc(ann.stamp)}</span>
        <div class="annot-quote">“${esc(ann.text || '')}”</div>
        <button class="emap-del" data-ann-del="${esc(ann.id)}">✕</button>
      </div>
      <textarea class="annot-item-note" rows="2" placeholder="Why does this count? What does it do in the answer?" data-ann-note="${esc(ann.id)}">${esc(ann.note||'')}</textarea>`;
    item.querySelector('[data-ann-del]').onclick = ()=> removeAnnotation(ann.id);
    item.querySelector('[data-ann-note]').addEventListener('input',e=>{
      const target = state.data.annotations.find(a=>a.id===ann.id);
      if(target) target.note = e.target.value;
      syncAnnotatedStateFromDom();
      queueSave();
    });
    wrap.appendChild(item);
  });
  syncEmapFromAnnotations();
}
