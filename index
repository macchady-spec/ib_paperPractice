function stampVar(s){
  const map={"DEF":"DEF","EV":"EV","SH":"SH","IMP":"IMP","LINK":"LINK","JDG":"JDG","ARG+":"ARGP","ARG-":"ARGM","CB":"CB","SIM":"SIM","DIFF":"DIFF","SRC-C":"SRCC","SRC-D":"SRCD"};
  return map[s]||"muted";
}

