function computeScore(){
  const f=fam();
  const post = state.data.post || {};
  const items = f.postChecklist;
  const totalW = items.reduce((s,i)=>s+(i.weight||1),0);
  const gotW   = items.reduce((s,i)=>s+(post[i.id]?(i.weight||1):0),0);
  let score = Math.round((gotW/totalW) * f.marks);
  // Hard caps: if an item has a cap and is unchecked, cap score
  const capsApplied = [];
  items.forEach(i=>{
    if(i.cap!==null && i.cap!==undefined && !post[i.id]){
      if(score>i.cap){
        capsApplied.push({text:i.text,cap:i.cap});
        score=i.cap;
      } else {
        capsApplied.push({text:i.text,cap:i.cap,silent:true});
      }
    }
  });
  if(score<0)score=0;
  if(score>f.marks)score=f.marks;
  return {score, total:f.marks, capsApplied, gotW, totalW};
}

function bandForScore(s,max){
  const r = s/max;
  if(r>=0.85) return {name:"Top band",cls:"top"};
  if(r>=0.65) return {name:"Upper mid",cls:"good"};
  if(r>=0.4)  return {name:"Mid band",cls:"mid"};
  return {name:"Low band",cls:"low"};
}

function renderStep7(){
  const res = computeScore();
  const band = bandForScore(res.score, res.total);
  $("#scNum").textContent = res.score;
  $("#scMax").textContent = "/ "+res.total;
  const bandEl = $("#scBand");
  bandEl.textContent = band.name;
  bandEl.className = "sc-band "+band.cls;
  // caps
  const caps = res.capsApplied.filter(c=>!c.silent);
  const capsBox = $("#scCaps");
  if(caps.length){
    capsBox.classList.add("vis");
    capsBox.innerHTML = "<strong>Hard caps applied because:</strong>"+
      caps.map(c=>`<div>• unchecked → "${esc(c.text)}" · score capped at ${c.cap}</div>`).join("");
  } else {
    capsBox.classList.remove("vis");
    capsBox.innerHTML="";
  }
  // notes
  const wc = wordCount(state.data.response||"");
  const annCount = (state.data.annotations||[]).length;
  $("#scNotes").innerHTML =
    `Self-identified evidence: ${res.gotW}/${res.totalW} weight-points · Response length: ${wc} words`+
    (annCount?` · ${annCount} direct text annotation${annCount===1?"":"s"} logged`:(state.data.emap&&state.data.emap.length?` · ${state.data.emap.length} evidence rows logged`:""));

  // AI prompt
  $("#promptBox").textContent = buildAIPrompt(res);
}

function buildAIPrompt(scoreRes){
  const f=fam();
  const q=activeQuestion();
  const brain=state.data.brain||{};
  const post=state.data.post||{};
  const emap=state.data.emap||[];
  const lines=[];
  lines.push("You are an IB Digital Society examiner.");
  lines.push("Mark the student response below against the official IB markband. Do NOT inflate praise. Stay close to the rubric. Penalise vagueness. Do NOT rewrite the whole answer. If the student's self-assessment looks unrealistic, challenge it.");
  lines.push("");
  lines.push("QUESTION FAMILY: "+f.paper+" · "+f.label+" ("+f.marks+" marks)");
  lines.push("COMMAND TERMS: "+f.cmdterms.join(" / "));
  lines.push("QUESTION TITLE: "+(q.title||""));
  lines.push("QUESTION TEXT:");
  lines.push(q.text||"");
  lines.push("");
  lines.push("MARKSCHEME ANCHORS:");
  activeMScheme().forEach(a=>lines.push("• "+a));
  lines.push("");
  lines.push("NON-NEGOTIABLES:");
  activeNonneg().forEach(n=>lines.push("• "+n));
  lines.push("");
  lines.push("STUDENT BRAINSTORM:");
  f.brainFields.forEach(fld=>{
    const v=brain[fld.id]||"(blank)";
    lines.push("- "+fld.label+": "+v);
  });
  lines.push("");
  lines.push("STUDENT RESPONSE:");
  lines.push((state.data.response||"(blank)"));
  lines.push("");
  lines.push("STUDENT EVIDENCE MAP (annotations located by the student):");
  if(emap.length){
    emap.forEach(r=>{
      if(r.quote||r.note){
        lines.push(`- [${r.stamp}] "${r.quote||"(no quote)"}" — ${r.note||"(no note)"}`);
      }
    });
  } else {
    lines.push("(no evidence logged)");
  }
  lines.push("");
  lines.push("SELF-ASSESSMENT CHECKLIST:");
  f.postChecklist.forEach(i=>{
    lines.push(`- [${post[i.id]?"x":" "}] ${i.text}`+(i.cap!==null&&i.cap!==undefined?` (cap if unchecked: ${i.cap})`:""));
  });
  lines.push("");
  lines.push("PROVISIONAL SCORE (self-identified): "+scoreRes.score+"/"+scoreRes.total);
  if(scoreRes.capsApplied.filter(c=>!c.silent).length){
    lines.push("Hard caps applied: "+scoreRes.capsApplied.filter(c=>!c.silent).map(c=>`"${c.text}" → cap ${c.cap}`).join("; "));
  }
  lines.push("");
  lines.push("PLEASE RETURN EXACTLY THESE ITEMS:");
  lines.push("1. Estimated mark out of "+f.marks+" (a single integer).");
  lines.push("2. Band label (from the rubric above).");
  lines.push("3. What is working (2–3 bullets, tied to rubric language).");
  lines.push("4. What is missing (2–3 bullets, tied to rubric language).");
  lines.push("5. Is the response primarily descriptive or analytical? Justify in one sentence.");
  lines.push("6. One short verbatim quote from the student's writing that best illustrates your judgement.");
  lines.push("7. One next-step revision target (concrete — naming the sentence or paragraph to revise).");
  lines.push("");
  lines.push("If the student's self-assessment looks unrealistic (e.g., full ticks but weak response), say so explicitly.");
  return lines.join("\n");
}

