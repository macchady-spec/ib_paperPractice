function deepClone(obj){ return JSON.parse(JSON.stringify(obj)); }

function normalizeImportedPack(obj){
  if(!obj || typeof obj !== 'object') throw new Error('The JSON file is empty or invalid.');
  const family = obj.family || obj.familyKey || obj.questionFamily || state.famKey || 'P1-8';
  const q = obj.customQuestion || obj.custom || obj.question || null;
  const custom = q ? {
    title: q.title || obj.title || 'Imported question',
    text: q.text || q.questionText || obj.text || obj.questionText || '',
    anchors: Array.isArray(q.anchors) ? q.anchors : Array.isArray(q.markscheme) ? q.markscheme : Array.isArray(obj.anchors) ? obj.anchors : Array.isArray(obj.markscheme) ? obj.markscheme : [],
    nonneg: Array.isArray(q.nonneg) ? q.nonneg : Array.isArray(q.nonNegotiables) ? q.nonNegotiables : Array.isArray(obj.nonneg) ? obj.nonneg : Array.isArray(obj.nonNegotiables) ? obj.nonNegotiables : []
  } : null;
  if(custom && !custom.text) throw new Error('Imported JSON needs question text in customQuestion.text (or equivalent).');
  const data = obj.data || obj.seedData || {};
  return {family, custom, data};
}

function applyPack(pack,{step=1,seed=false}={}){
  const normalized = normalizeImportedPack(pack);
  state.famKey = normalized.family || 'P1-8';
  state.custom = normalized.custom || null;
  if(state.custom){
    localStorage.setItem(LS_CUSTOM+state.famKey, JSON.stringify(state.custom));
  } else {
    localStorage.removeItem(LS_CUSTOM+state.famKey);
  }
  state.data = normalized.data ? deepClone(normalized.data) : {};
  state.step = step;
  if(seed){ localStorage.setItem(LS_PREFIX+'demoSeeded','1'); }
  saveState();
  renderAll();
}

function buildQuestionPack(){
  return {
    schema: 'ib-digsoc-question-pack-v1',
    family: state.famKey,
    customQuestion: state.custom ? deepClone(state.custom) : {
      title: activeQuestion().title || 'Current question',
      text: activeQuestion().text || '',
      anchors: deepClone(activeMScheme()),
      nonneg: deepClone(activeNonneg())
    },
    data: deepClone(state.data)
  };
}

function isDemoPackActive(){
  return state.data && state.data._seed === 'instagram_demo_v1';
}

function isBlankStudio(){
  const hasCustom = !!(state.custom && (state.custom.text || '').trim());
  const hasData = !!(state.data && Object.keys(state.data).some(k => {
    if(k === '_seed') return false;
    const v = state.data[k];
    if(v == null) return false;
    if(typeof v === 'string') return v.trim().length > 0;
    if(Array.isArray(v)) return v.length > 0;
    if(typeof v === 'object') return Object.keys(v).length > 0;
    return true;
  }));
  return !hasCustom && !hasData;
}

function blankQuestion(){
  return {
    title: "No question loaded",
    text: "",
    hint: "Use Custom Question, Import JSON, or Load Worked Example."
  };
}

function renderDemoNotice(){
