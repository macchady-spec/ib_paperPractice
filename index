<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>IB Digital Society — Response Studio · Standard</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0E1020;--surface:#161932;--surface2:#1D2144;--surface3:#262B55;--border:#2E3360;
  --text:#E8EAF5;--text2:#AAB0D2;--muted:#7379A8;--shadow:rgba(0,0,0,.55);
  --gold:#E8B84B;--gold-dim:rgba(232,184,75,.12);--gold-bd:rgba(232,184,75,.32);
  --teal:#22D3BB;--teal-dim:rgba(34,211,187,.1);--teal-bd:rgba(34,211,187,.3);
  --ok:#10B981;--ok-bg:rgba(16,185,129,.1);--ok-bd:rgba(16,185,129,.3);
  --warn:#F59E0B;--warn-bg:rgba(245,158,11,.1);--warn-bd:rgba(245,158,11,.3);
  --err:#F43F5E;--err-bg:rgba(244,63,94,.1);--err-bd:rgba(244,63,94,.3);
  --DEF:#F59E0B;--EV:#10B981;--SH:#3B82F6;--IMP:#06B6D4;--LINK:#F97316;
  --JDG:#E8B84B;--ARGP:#84CC16;--ARGM:#F43F5E;--CB:#8B5CF6;
  --SIM:#22D3BB;--DIFF:#E879F9;--SRCC:#60A5FA;--SRCD:#FB7185;
}
html,body{height:100%}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Inter,sans-serif;background:var(--bg);color:var(--text);overflow-x:hidden;line-height:1.5}

/* ── HEADER ── */
header{position:sticky;top:0;z-index:50;background:var(--surface);border-bottom:1px solid var(--border);padding:10px 18px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;box-shadow:0 2px 8px var(--shadow)}
.brand{font-family:Georgia,serif;font-size:18px;color:var(--gold);font-weight:700;letter-spacing:.3px}
.brand em{font-style:normal;color:var(--muted);font-size:11px;margin-left:6px;font-weight:400;font-family:-apple-system,sans-serif;letter-spacing:.5px;text-transform:uppercase}
.h-sep{width:1px;height:22px;background:var(--border)}
.fam-group{display:flex;gap:4px;align-items:center}
.fam-label{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;font-weight:700;margin-right:4px}
.fam{padding:6px 11px;border-radius:6px;border:1px solid var(--border);background:transparent;color:var(--text2);cursor:pointer;font-size:11px;font-weight:600;transition:all .12s;font-family:inherit}
.fam:hover{border-color:var(--gold);color:var(--text)}
.fam.on{background:var(--gold-dim);border-color:var(--gold);color:var(--gold)}
.fam small{opacity:.7;font-weight:500;margin-left:3px}
.h-space{flex:1}
.h-btn{padding:7px 12px;border-radius:6px;border:1px solid var(--border);background:var(--surface2);color:var(--text2);cursor:pointer;font-size:11px;font-weight:600;transition:all .12s;font-family:inherit}
.h-btn:hover{border-color:var(--teal);color:var(--teal)}
.h-btn.on{background:var(--teal-dim);border-color:var(--teal);color:var(--teal)}
.save-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--ok);margin-right:5px;vertical-align:middle}
.saveind{font-size:10px;color:var(--muted);padding:5px 8px;border-radius:4px;background:var(--surface2);border:1px solid var(--border)}

/* ── STEP RAIL ── */
.rail{position:sticky;top:64px;z-index:40;background:var(--surface);border-bottom:1px solid var(--border);padding:8px 18px;display:flex;gap:4px;overflow-x:auto}
.rstep{flex:0 0 auto;padding:8px 12px;border-radius:6px;background:transparent;border:1px solid var(--border);color:var(--text2);cursor:pointer;font-size:11px;font-weight:600;transition:all .12s;display:flex;align-items:center;gap:7px;font-family:inherit}
.rstep:hover{border-color:var(--teal);color:var(--text)}
.rstep.on{background:var(--teal-dim);border-color:var(--teal);color:var(--teal)}
.rstep .rn{width:18px;height:18px;border-radius:50%;background:var(--surface3);color:var(--text2);font-size:10px;font-weight:700;display:inline-flex;align-items:center;justify-content:center}
.rstep.on .rn{background:var(--teal);color:#0E1020}
.rstep.done .rn{background:var(--ok);color:#0E1020}

/* ── LAYOUT ── */
main{max-width:1280px;margin:0 auto;padding:22px 18px 80px}
.panel{display:none;animation:fadeIn .2s}
.panel.on{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
.ptitle{font-family:Georgia,serif;font-size:22px;color:var(--gold);margin-bottom:4px}
.psub{font-size:12px;color:var(--muted);margin-bottom:18px}

/* ── CARDS ── */
.card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:16px;margin-bottom:14px}
.card h3{font-size:12px;text-transform:uppercase;letter-spacing:.1em;color:var(--gold);margin-bottom:8px;font-weight:700}
.card p{font-size:13px;color:var(--text2);line-height:1.6}
.card ul{list-style:none;padding:0}
.card li{font-size:13px;color:var(--text2);padding:4px 0 4px 18px;position:relative;line-height:1.55}
.card li::before{content:"›";color:var(--gold);position:absolute;left:4px;font-weight:700}
.card.teal h3{color:var(--teal)}
.card.teal{border-color:var(--teal-bd);background:linear-gradient(180deg,var(--teal-dim),var(--surface))}
.card.warn h3{color:var(--warn)}
.card.warn{border-color:var(--warn-bd)}
.card.err h3{color:var(--err)}
.card.err{border-color:var(--err-bd)}
.card.ok h3{color:var(--ok)}
.card.ok{border-color:var(--ok-bd)}

/* Question block */
.qhead{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-start;margin-bottom:8px}
.qhead .chip{font-size:10px;font-weight:700;padding:3px 8px;border-radius:4px;background:var(--surface3);color:var(--text);text-transform:uppercase;letter-spacing:.08em}
.qhead .chip.gold{background:var(--gold);color:#0E1020}
.qhead .chip.teal{background:var(--teal);color:#0E1020}
.qtext{font-size:14px;color:var(--text);line-height:1.65;padding:12px 14px;background:var(--surface2);border-left:3px solid var(--gold);border-radius:4px;margin-top:6px;white-space:pre-wrap}
.qhint{font-size:11px;color:var(--muted);margin-top:6px;font-style:italic}

/* ── GRIDS ── */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.grid-sbs{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:900px){.grid2,.grid-sbs{grid-template-columns:1fr}}

/* ── INPUTS ── */
label.field{display:block;margin-bottom:12px}
label.field>.lbl{display:block;font-size:11px;font-weight:700;color:var(--text);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px}
label.field>.lbl small{color:var(--muted);font-weight:500;text-transform:none;letter-spacing:0;margin-left:6px;font-size:10px;font-style:italic}
.input,.ta{width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:6px;padding:8px 10px;color:var(--text);font-family:inherit;font-size:13px;line-height:1.55;resize:vertical;transition:border-color .12s}
.ta{min-height:60px}
.ta.long{min-height:120px}
.ta.xlong{min-height:300px}
.input:focus,.ta:focus{outline:none;border-color:var(--teal);background:var(--surface3)}
.hint{font-size:11px;color:var(--muted);margin-top:4px;line-height:1.5}

/* ── CHECKLIST ── */
.clist{list-style:none;padding:0}
.cli{display:flex;gap:10px;padding:9px 11px;border:1px solid var(--border);border-radius:6px;margin-bottom:6px;background:var(--surface2);cursor:pointer;transition:all .12s;align-items:flex-start}
.cli:hover{border-color:var(--teal);background:var(--surface3)}
.cli input{margin-top:3px;cursor:pointer;accent-color:var(--teal)}
.cli-text{font-size:12px;color:var(--text);flex:1;line-height:1.5}
.cli.checked{background:var(--ok-bg);border-color:var(--ok-bd)}
.cli.checked .cli-text{color:var(--ok)}
.cli .cli-hint{font-size:10px;color:var(--muted);margin-top:3px;font-style:italic}
.cli .cap-warn{font-size:9px;font-weight:700;color:var(--err);background:var(--err-bg);border:1px solid var(--err-bd);padding:1px 5px;border-radius:3px;margin-left:4px;text-transform:uppercase;letter-spacing:.04em}

/* ── RUBRIC ── */
.band{background:var(--surface2);border:1px solid var(--border);border-radius:7px;padding:10px 12px;margin-bottom:6px}
.band-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;gap:8px}
.band-lvl{font-size:12px;font-weight:700}
.band-m{padding:2px 7px;border-radius:3px;font-size:10px;font-weight:700;white-space:nowrap}
.band-m.top{background:var(--gold);color:#0E1020}
.band-m.good{background:var(--ok);color:#fff}
.band-m.mid{background:var(--warn);color:#0E1020}
.band-m.low{background:var(--err);color:#fff}
.band-d{font-size:12px;color:var(--text2);line-height:1.55}

/* ── ANNOTATION STAMPS ── */
.stampbar{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:10px;padding:10px;background:var(--surface2);border:1px solid var(--border);border-radius:6px}
.stamp{padding:4px 9px;border-radius:4px;font-size:10px;font-weight:700;letter-spacing:.04em;border:1.5px solid;background:transparent;cursor:pointer;transition:all .12s;font-family:inherit}
.stamp[data-s="DEF"]{color:var(--DEF);border-color:var(--DEF)}
.stamp[data-s="EV"]{color:var(--EV);border-color:var(--EV)}
.stamp[data-s="SH"]{color:var(--SH);border-color:var(--SH)}
.stamp[data-s="IMP"]{color:var(--IMP);border-color:var(--IMP)}
.stamp[data-s="LINK"]{color:var(--LINK);border-color:var(--LINK)}
.stamp[data-s="JDG"]{color:var(--JDG);border-color:var(--JDG)}
.stamp[data-s="ARG+"]{color:var(--ARGP);border-color:var(--ARGP)}
.stamp[data-s="ARG-"]{color:var(--ARGM);border-color:var(--ARGM)}
.stamp[data-s="CB"]{color:var(--CB);border-color:var(--CB)}
.stamp[data-s="SIM"]{color:var(--SIM);border-color:var(--SIM)}
.stamp[data-s="DIFF"]{color:var(--DIFF);border-color:var(--DIFF)}
.stamp[data-s="SRC-C"]{color:var(--SRCC);border-color:var(--SRCC)}
.stamp[data-s="SRC-D"]{color:var(--SRCD);border-color:var(--SRCD)}
.stamp:hover{transform:translateY(-1px)}
.stamp-legend{font-size:10px;color:var(--muted);line-height:1.6;margin-top:4px}

/* Evidence map */
.emap{background:var(--surface);border:1px solid var(--border);border-radius:8px;overflow:hidden}
.emap-row{display:grid;grid-template-columns:100px 1fr 1fr 28px;gap:1px;background:var(--border)}
.emap-cell{background:var(--surface);padding:7px 9px;font-size:11px;color:var(--text2)}
.emap-cell.label{font-weight:700;color:var(--text)}
.emap-cell input{width:100%;background:transparent;border:none;color:var(--text);font-size:12px;font-family:inherit;padding:2px 0}
.emap-cell input:focus{outline:none}
.emap-cell .tag{font-size:9px;font-weight:700;padding:2px 6px;border-radius:3px;color:#0E1020}
.emap-add{display:flex;gap:5px;margin-top:8px;flex-wrap:wrap}

/* ── INLINE RESPONSE ANNOTATOR ── */
.annot-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:14px}
@media(max-width:980px){.annot-grid{grid-template-columns:1fr}}
.annot-help{font-size:11px;color:var(--muted);margin-bottom:8px;line-height:1.6}
.annot-help strong{color:var(--text)}
.annot-toolbar{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0 8px}
.annot-status{font-size:11px;color:var(--muted);margin-bottom:8px;min-height:18px}
.annot-status.warn{color:var(--warn)}
.annot-status.err{color:var(--err)}
.annot-surface-wrap{border:1px solid var(--border);border-radius:10px;background:var(--surface2);padding:12px}
.annot-surface{min-height:260px;max-height:420px;overflow:auto;padding:14px;border:1px dashed var(--border);border-radius:8px;background:var(--surface);line-height:1.8;font-size:14px;color:var(--text)}
.annot-surface p{margin:0 0 12px 0}
.annot-surface p:last-child{margin-bottom:0}
.annot-surface.empty{display:flex;align-items:center;justify-content:center;color:var(--muted);font-style:italic}
.inline-annot{--ann-color:var(--gold);border-bottom:3px solid var(--ann-color);padding:0 .08em;border-radius:4px;position:relative;background:rgba(255,255,255,.02)}
.inline-annot[data-stamp="DEF"]{--ann-color:var(--DEF)}
.inline-annot[data-stamp="EV"]{--ann-color:var(--EV)}
.inline-annot[data-stamp="SH"]{--ann-color:var(--SH)}
.inline-annot[data-stamp="IMP"]{--ann-color:var(--IMP)}
.inline-annot[data-stamp="LINK"]{--ann-color:var(--LINK)}
.inline-annot[data-stamp="JDG"]{--ann-color:var(--JDG)}
.inline-annot[data-stamp="ARG+"]{--ann-color:var(--ARGP)}
.inline-annot[data-stamp="ARG-"]{--ann-color:var(--ARGM)}
.inline-annot[data-stamp="CB"]{--ann-color:var(--CB)}
.inline-annot[data-stamp="SIM"]{--ann-color:var(--SIM)}
.inline-annot[data-stamp="DIFF"]{--ann-color:var(--DIFF)}
.inline-annot[data-stamp="SRC-C"]{--ann-color:var(--SRCC)}
.inline-annot[data-stamp="SRC-D"]{--ann-color:var(--SRCD)}
.inline-badge{display:inline-flex;align-items:center;justify-content:center;margin-left:4px;padding:1px 5px;border-radius:10px;font-size:9px;font-weight:800;letter-spacing:.04em;background:var(--ann-color);color:#0E1020;vertical-align:middle}
.annot-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.annot-summary{font-size:11px;color:var(--muted);margin-bottom:10px;line-height:1.6}
.annot-summary .tag{font-size:9px;font-weight:700;padding:2px 6px;border-radius:3px;color:#0E1020;margin-right:4px}
.annot-log{display:flex;flex-direction:column;gap:8px}
.annot-log-empty{border:1px dashed var(--border);border-radius:8px;padding:12px;color:var(--muted);font-size:12px;font-style:italic}
.annot-item{border:1px solid var(--border);border-radius:8px;background:var(--surface2);padding:10px}
.annot-item-head{display:flex;align-items:flex-start;gap:8px;margin-bottom:6px}
.annot-item-head .tag{font-size:9px;font-weight:700;padding:2px 6px;border-radius:3px;color:#0E1020;flex:0 0 auto}
.annot-quote{font-size:12px;color:var(--text);line-height:1.6;flex:1}
.annot-item-note{width:100%;background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:8px 10px;color:var(--text);font-family:inherit;font-size:12px;line-height:1.5}
.annot-item-note:focus{outline:none;border-color:var(--teal)}
.annot-warn{margin-bottom:10px;padding:10px 12px;background:var(--warn-bg);border:1px solid var(--warn-bd);border-radius:8px;font-size:11px;color:var(--warn);line-height:1.6}
.annot-warn strong{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:4px}
.emap-del{background:transparent;border:none;color:var(--muted);cursor:pointer;font-size:14px;padding:0 4px}
.emap-del:hover{color:var(--err)}
.emap-head{background:var(--surface2);font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:700}

/* ── SCORE CARD ── */
.scorecard{background:linear-gradient(140deg,var(--gold-dim) 0%,var(--surface) 50%);border:2px solid var(--gold);border-radius:12px;padding:20px;margin-bottom:14px;position:relative;overflow:hidden}
.sc-label{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:var(--gold);font-weight:700;margin-bottom:4px}
.sc-main{display:flex;align-items:baseline;gap:10px;margin-bottom:6px}
.sc-num{font-family:Georgia,serif;font-size:56px;color:var(--gold);font-weight:700;line-height:1}
.sc-max{font-size:20px;color:var(--muted)}
.sc-band{font-size:12px;padding:4px 10px;border-radius:4px;background:var(--surface3);color:var(--text);font-weight:600;border:1px solid var(--border)}
.sc-band.top{background:var(--gold);color:#0E1020;border-color:var(--gold)}
.sc-band.good{background:var(--ok);color:#fff;border-color:var(--ok)}
.sc-band.mid{background:var(--warn);color:#0E1020;border-color:var(--warn)}
.sc-band.low{background:var(--err);color:#fff;border-color:var(--err)}
.sc-caveat{font-size:11px;color:var(--muted);font-style:italic;margin-top:6px}
.sc-caps{margin-top:10px;padding:8px 10px;background:var(--err-bg);border:1px solid var(--err-bd);border-radius:6px;font-size:11px;color:var(--err);line-height:1.6;display:none}
.sc-caps.vis{display:block}
.sc-caps strong{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:4px}
.sc-notes{margin-top:10px;font-size:11px;color:var(--text2);line-height:1.6}

/* AI prompt area */
.promptbox{background:var(--surface2);border:1px solid var(--border);border-radius:6px;padding:12px;font-family:Menlo,Monaco,Consolas,monospace;font-size:11px;color:var(--text2);line-height:1.55;white-space:pre-wrap;max-height:360px;overflow-y:auto}
.copybtn{margin-top:8px;padding:8px 14px;background:var(--teal);color:#0E1020;border:none;border-radius:6px;cursor:pointer;font-weight:700;font-family:inherit;font-size:12px}
.copybtn:hover{opacity:.9}
.copybtn.done{background:var(--ok);color:#fff}

/* Nav buttons between steps */
.stepnav{display:flex;justify-content:space-between;margin-top:18px;gap:10px}
.stepnav button{padding:10px 18px;border:1px solid var(--border);border-radius:6px;background:var(--surface2);color:var(--text);cursor:pointer;font-weight:600;font-family:inherit;font-size:12px}
.stepnav button.primary{background:var(--teal);color:#0E1020;border-color:var(--teal)}
.stepnav button.primary:hover{opacity:.9}
.stepnav button:hover{border-color:var(--teal)}

/* Modal */
.modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.72);z-index:100;display:none;align-items:center;justify-content:center;padding:18px}
.modal-bg.vis{display:flex}
.modal{background:var(--surface);border:1px solid var(--border);border-radius:12px;max-width:700px;width:100%;max-height:90vh;overflow-y:auto;padding:24px;box-shadow:0 20px 60px var(--shadow)}
.modal h2{font-family:Georgia,serif;color:var(--gold);font-size:20px;margin-bottom:4px}
.modal-sub{font-size:11px;color:var(--muted);margin-bottom:14px}
.modal-close-row{display:flex;gap:8px;justify-content:flex-end;margin-top:14px}
.modal-close-row button{padding:9px 16px;border-radius:6px;border:1px solid var(--border);background:var(--surface2);color:var(--text);cursor:pointer;font-family:inherit;font-size:12px;font-weight:600}
.modal-close-row button.primary{background:var(--teal);color:#0E1020;border-color:var(--teal)}

/* Exemplar narrative */
.exemplar-narrative{background:linear-gradient(140deg,var(--teal-dim),var(--surface));border:1px dashed var(--teal-bd);border-radius:10px;padding:14px;margin-bottom:14px;display:none}
.exemplar-narrative.vis{display:block}
.exemplar-narrative h4{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--teal);font-weight:700;margin-bottom:6px;display:flex;align-items:center;gap:6px}
.exemplar-narrative h4::before{content:"◆";color:var(--teal)}
.exemplar-narrative p,.exemplar-narrative li{font-size:12px;color:var(--text2);line-height:1.65}
.exemplar-narrative ul{padding-left:18px;margin:4px 0}
.exemplar-narrative strong{color:var(--text)}
.exmode-banner{background:var(--teal-dim);border:1px solid var(--teal);border-radius:6px;padding:8px 12px;margin-bottom:14px;font-size:12px;color:var(--teal);display:none;align-items:center;gap:8px}
.exmode-banner.vis{display:flex}
.exmode-banner strong{font-weight:700}

/* Misc */
.pill{font-size:10px;padding:2px 8px;border-radius:10px;background:var(--surface3);color:var(--text2);font-weight:600;letter-spacing:.02em}
.row-act{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.mini-btn{padding:6px 10px;border-radius:5px;border:1px solid var(--border);background:var(--surface2);color:var(--text2);cursor:pointer;font-size:11px;font-weight:600;font-family:inherit}
.mini-btn:hover{border-color:var(--teal);color:var(--teal)}
.mini-btn.danger{color:var(--err);border-color:var(--err-bd)}
.mini-btn.danger:hover{background:var(--err-bg)}
.two-col-list{columns:2;column-gap:20px}
@media(max-width:720px){.two-col-list{columns:1}}
.gate{padding:10px 12px;background:var(--warn-bg);border:1px solid var(--warn-bd);color:var(--warn);font-size:11px;border-radius:6px;margin-bottom:12px;display:none}
.gate.vis{display:block}
.teacher-row{display:grid;grid-template-columns:1fr 1fr 1fr 1fr 60px 28px;gap:6px;margin-bottom:6px;align-items:flex-start}
.teacher-row input,.teacher-row textarea{width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:5px;padding:6px 8px;color:var(--text);font-family:inherit;font-size:11px;resize:vertical;min-height:34px}
.teacher-row .emap-del{min-height:30px}
.teacher-head{background:var(--surface2);padding:8px;border-radius:6px;margin-bottom:6px;font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);font-weight:700;display:grid;grid-template-columns:1fr 1fr 1fr 1fr 60px 28px;gap:6px}
@media(max-width:1000px){
  .teacher-row,.teacher-head{grid-template-columns:1fr 1fr}
}
</style>
</head>
<body>

<header>
  <div class="brand">DigSoc Response Studio<em>Student · guided simulator</em></div>
  <div class="h-sep"></div>
  <div class="fam-group">
    <span class="fam-label">P1</span>
    <button class="fam" data-fam="P1-2">2<small>id</small></button>
    <button class="fam" data-fam="P1-4">4<small>exp</small></button>
    <button class="fam" data-fam="P1-6">6<small>anl</small></button>
    <button class="fam" data-fam="P1-8">8<small>dsc</small></button>
  </div>
  <div class="h-sep"></div>
  <div class="fam-group">
    <span class="fam-label">P2</span>
    <button class="fam" data-fam="P2-Q1">Q1<small>2</small></button>
    <button class="fam" data-fam="P2-Q2">Q2<small>4</small></button>
    <button class="fam" data-fam="P2-Q3">Q3<small>6</small></button>
    <button class="fam" data-fam="P2-Q4">Q4<small>12</small></button>
  </div>
  <div class="h-space"></div>
  <button class="h-btn" id="btnExemplar">Exemplar Mode</button>
  <button class="h-btn" id="btnCustom">Custom Question</button>
  <button class="h-btn" id="btnLoadDemo">Load Worked Example</button>
  <button class="h-btn" id="btnImportJson">Import JSON</button>
  <button class="h-btn" id="btnReset">Reset</button>
  <span class="saveind" id="saveind"><span class="save-dot"></span>autosaved</span>
</header>

<nav class="rail" id="rail">
  <button class="rstep" data-step="1"><span class="rn">1</span>Understand</button>
  <button class="rstep" data-step="2"><span class="rn">2</span>Exemplar mindset</button>
  <button class="rstep" data-step="3"><span class="rn">3</span>Brainstorm</button>
  <button class="rstep" data-step="4"><span class="rn">4</span>Write</button>
  <button class="rstep" data-step="5"><span class="rn">5</span>Annotate</button>
  <button class="rstep" data-step="6"><span class="rn">6</span>Self-assess</button>
  <button class="rstep" data-step="7"><span class="rn">7</span>Score + AI prompt</button>
</nav>

<main>

  <div class="exmode-banner" id="exBanner"><strong>Exemplar walkthrough mode active.</strong> Read-only guidance panels are visible at every step. Your inputs are preserved and will reappear when you turn the mode off.</div>

  <div class="card teal" id="demoNotice" style="display:none;margin-bottom:14px">
    <h3>Loaded worked example</h3>
    <p>A worked example is currently loaded. You can clear it, import your own JSON question pack, or create a custom question.</p>
  </div>

  <div class="card" id="blankNotice" style="display:none;margin-bottom:14px">
    <h3>Start here</h3>
    <p>No question is loaded yet. Use <strong>Custom Question</strong>, <strong>Import JSON</strong>, or <strong>Load Worked Example</strong> to begin.</p>
  </div>

  <!-- STEP 1 -->
  <section class="panel" id="p1">
    <h2 class="ptitle">Step 1 · Understand the question</h2>
    <p class="psub">Read the question slowly. Before you plan anything, make sure you know what it is actually asking.</p>
    <div class="exemplar-narrative" id="ex1"></div>
    <div class="card">
      <div class="qhead" id="qhead"></div>
      <div class="qtext" id="qtext"></div>
      <p class="qhint" id="qhint"></p>
    </div>
    <div class="grid2">
      <div class="card teal">
        <h3>Markscheme anchors</h3>
        <ul id="mscheme"></ul>
      </div>
      <div class="card warn">
        <h3>Non-negotiables</h3>
        <ul id="nonneg"></ul>
      </div>
    </div>
    <div class="grid2">
      <div class="card">
        <h3>What this question is really testing</h3>
        <p id="testing"></p>
      </div>
      <div class="card">
        <h3>Command term focus</h3>
        <p id="cmdfocus"></p>
      </div>
    </div>
    <div class="grid2">
      <div class="card err">
        <h3>What weak students do</h3>
        <ul id="weak"></ul>
      </div>
      <div class="card ok">
        <h3>What strong students do</h3>
        <ul id="strong"></ul>
      </div>
    </div>
    <div class="stepnav"><span></span><button class="primary" data-go="2">Next · Exemplar mindset →</button></div>
  </section>

  <!-- STEP 2 -->
  <section class="panel" id="p2">
    <h2 class="ptitle">Step 2 · Exemplar mindset</h2>
    <p class="psub">Inside the mind of a high-performing student before they write a single word.</p>
    <div class="card teal">
      <h3>What the exemplar notices and plans</h3>
      <ul id="exmind"></ul>
    </div>
    <div class="grid2">
      <div class="card">
        <h3>How the exemplar reads the command term</h3>
        <p id="excmd"></p>
      </div>
      <div class="card">
        <h3>How the exemplar uses sources / evidence</h3>
        <p id="exsrc"></p>
      </div>
    </div>
    <div class="grid2">
      <div class="card warn">
        <h3>Traps the exemplar avoids</h3>
        <ul id="extraps"></ul>
      </div>
      <div class="card ok">
        <h3>What the exemplar has ready before writing</h3>
        <ul id="explan"></ul>
      </div>
    </div>
    <div class="stepnav"><button data-go="1">← Back</button><button class="primary" data-go="3">Next · Brainstorm →</button></div>
  </section>

  <!-- STEP 3 -->
  <section class="panel" id="p3">
    <h2 class="ptitle">Step 3 · Brainstorm before writing</h2>
    <p class="psub">Plan first. Use keywords and fragments — not finished sentences. This scaffolds your thinking; it does not replace it.</p>
    <div class="exemplar-narrative" id="ex3"></div>
    <div class="card">
      <h3>Pre-write checklist</h3>
      <ul class="clist" id="preclist"></ul>
    </div>
    <div class="card">
      <h3>Plan your response</h3>
      <div id="brainfields"></div>
    </div>
    <div class="stepnav"><button data-go="2">← Back</button><button class="primary" data-go="4">Next · Write →</button></div>
  </section>

  <!-- STEP 4 -->
  <section class="panel" id="p4">
    <h2 class="ptitle">Step 4 · Write the response</h2>
    <p class="psub">Your brainstorm stays visible on the left. Write the full response on the right.</p>
    <div class="gate" id="writeGate">Complete your brainstorm in Step 3 before writing. You can still write, but a finished brainstorm produces much stronger responses.</div>
    <div class="grid-sbs">
      <div class="card">
        <h3>Brainstorm (read-only echo)</h3>
        <div id="brainecho" style="font-size:12px;color:var(--text2);line-height:1.65"></div>
      </div>
      <div class="card">
        <h3>Your response <span class="pill" id="wcpill">0 words</span></h3>
        <textarea id="writeBox" class="ta" placeholder="Write your response here…"></textarea>
      </div>
    </div>
    <div class="stepnav"><button data-go="3">← Back</button><button class="primary" data-go="5">Next · Annotate →</button></div>
  </section>

  <!-- STEP 5 -->
  <section class="panel" id="p5">
    <h2 class="ptitle">Step 5 · Annotate the full written sample</h2>
    <p class="psub">Select text inside the full response, click a stamp, then use the checklist to judge what is actually present. This keeps annotation tied to the real answer instead of copying fragments by hand.</p>
    <div class="exemplar-narrative" id="ex5"></div>
    <div class="annot-grid">
      <div class="card">
        <h3>Annotate your response</h3>
        <p class="annot-help"><strong>How it works:</strong> highlight a phrase in the answer, then click a stamp. The highlight is saved and appears in the annotation log automatically.</p>
        <div id="annotSyncWarn"></div>
        <div class="annot-toolbar stampbar" id="stampbar"></div>
        <p class="stamp-legend" id="stampLegend"></p>
        <div class="annot-status" id="annotStatus">Select text in the response, then click a stamp.</div>
        <div class="annot-surface-wrap">
          <div class="annot-surface" id="annotatedResponse"></div>
        </div>
        <div class="annot-actions">
          <button class="mini-btn" id="syncAnnotBtn">Use current Step 4 response</button>
          <button class="mini-btn danger" id="clearAnnotBtn">Clear all annotations</button>
        </div>
      </div>
      <div class="card">
        <h3>Annotation log</h3>
        <p class="annot-summary" id="annotationSummary"></p>
        <div class="annot-log" id="annotationLog"></div>
      </div>
    </div>
    <div class="stepnav"><button data-go="4">← Back</button><button class="primary" data-go="6">Next · Self-assess →</button></div>
  </section>

  <!-- STEP 6 -->
  <section class="panel" id="p6">
    <h2 class="ptitle">Step 6 · Self-assess with checklist and rubric</h2>
    <p class="psub">Tick only what is genuinely in your written response, using your annotations as evidence. Then compare against the official markband.</p>
    <div class="grid2">
      <div class="card">
        <h3>Post-write checklist</h3>
        <ul class="clist" id="postclist"></ul>
      </div>
      <div class="card teal">
        <h3>Rubric / markband</h3>
        <div id="rubric"></div>
        <p class="hint" id="rubricSrc"></p>
      </div>
    </div>
    <div class="stepnav"><button data-go="5">← Back</button><button class="primary" data-go="7">Next · Score →</button></div>
  </section>

  <!-- STEP 7 -->
  <section class="panel" id="p7">
    <h2 class="ptitle">Step 7 · Provisional score + AI prompt</h2>
    <p class="psub">The score below is a provisional estimate based on your self-identified evidence. It is not a final mark.</p>
    <div class="scorecard" id="scorecard">
      <div class="sc-label">Provisional estimate based on self-identified evidence</div>
      <div class="sc-main"><div class="sc-num" id="scNum">–</div><div class="sc-max" id="scMax">/ —</div><div class="sc-band" id="scBand">—</div></div>
      <div class="sc-caveat">Not a final IB mark. Use the AI prompt below and your teacher's verification (Step 8) to refine.</div>
      <div class="sc-caps" id="scCaps"></div>
      <div class="sc-notes" id="scNotes"></div>
    </div>
    <div class="card">
      <h3>AI feedback prompt (copy into Gemini / Claude / GPT)</h3>
      <p class="hint">Copy the prompt and paste your text into the LLM. The prompt tells the AI to stay close to the rubric, not to inflate praise, and not to rewrite your answer for you.</p>
      <div class="promptbox" id="promptBox"></div>
      <button class="copybtn" id="copyBtn">Copy prompt to clipboard</button>
    </div>
    <div class="stepnav"><button data-go="6">← Back</button><span></span></div>
    <div class="card" style="margin-top:14px">
      <h3>Export your work for your teacher</h3>
      <p style="font-size:12px;color:var(--text2);margin-bottom:8px">Send one of these files to your teacher. The JSON version can be loaded back into the teacher tool for verification.</p>
      <div class="row-act">
        <button class="mini-btn" id="exportJson">Export session (JSON)</button>
        <button class="mini-btn" id="exportTxt">Export report (Markdown)</button>
        <button class="mini-btn" id="exportQuestionPack">Export question pack JSON</button>
        <button class="mini-btn danger" id="clearThis">Clear my saved work for this question</button>
      </div>
    </div>
  </section>

  <!-- hidden teacher artefacts (kept so existing JS selectors still bind) -->
  <div style="display:none" id="p8">
    <div id="teachRows"></div>
    <input id="teachFinal"><textarea id="teachComment"></textarea>
    <button id="addTeachRow"></button>
  </div>

</main>

<!-- CUSTOM QUESTION MODAL -->
<div class="modal-bg" id="customModal">
  <div class="modal">
    <h2>Custom question</h2>
    <div class="modal-sub">Paste your own question and markscheme. The full workflow, rubric, and scoring logic will still apply for the currently selected question family.</div>
    <label class="field"><span class="lbl">Title / label</span><input class="input" id="cTitle" placeholder="e.g., Paper 1 Nov 2025 Q3c"></label>
    <label class="field"><span class="lbl">Question text</span><textarea class="ta long" id="cText" placeholder="Paste the full question wording here."></textarea></label>
    <label class="field"><span class="lbl">Markscheme anchors <small>one per line</small></span><textarea class="ta" id="cAnchors" placeholder="e.g.&#10;Award [1] per identified risk up to 2&#10;Award [1] for development up to 4"></textarea></label>
    <label class="field"><span class="lbl">Non-negotiables <small>one per line</small></span><textarea class="ta" id="cNonneg" placeholder="e.g.&#10;Must reference Source C&#10;Must explain mechanism"></textarea></label>
    <div class="modal-close-row">
      <button id="cClear">Clear custom</button>
      <button>Cancel</button>
      <button class="primary" id="cSave">Save custom question</button>
    </div>
  </div>
</div>

<!-- CONFIRM RESET -->
<div class="modal-bg" id="resetModal">
  <div class="modal">
    <h2>Reset this question?</h2>
    <div class="modal-sub">All brainstorm, response text, annotations, checklist ticks, and teacher notes for the currently selected question will be cleared from this browser.</div>
    <div class="modal-close-row">
      <button>Cancel</button>
      <button class="primary" id="confirmReset" style="background:var(--err);border-color:var(--err);color:#fff">Yes, clear this question</button>
    </div>
  </div>
</div>
<input type="file" id="jsonImportInput" accept=".json,application/json" style="display:none">

<script>
/* ============================================================
   DATA MODEL — Question families, rubric, checklists, exemplars
   Grounded in:
   - Markband guidance for all exam papers (Nov 2025)
   - Specimen Paper 1 & Paper 2 markschemes
   - Subject report (May 2025)
   Paper 2 Q1 is treated as 2 marks per project instructions.
============================================================ */

const STAMP_MEANINGS = {
  "DEF": "accurate term / definition",
  "EV":  "evidence / example",
  "SH":  "stakeholder",
  "IMP": "implication / so what",
  "LINK":"explicit link back to the question",
  "JDG": "judgement",
  "ARG+":"supporting side of the argument",
  "ARG-":"counter-side of the argument",
  "CB":  "balancing / cost–benefit weighing",
  "SIM": "similarity across sources",
  "DIFF":"difference across sources",
  "SRC-C":"reference to Source C",
  "SRC-D":"reference to Source D"
};

/* Each family has:
   paper, marks, label, cmdterms, sampleQ, mscheme, nonneg, testing, cmdFocus, weak, strong,
   exMind, exCmd, exSrc, exTraps, exPlan,
   preChecklist, brainFields, postChecklist, stamps, rubric, rubricSrc,
   exemplarNarrative (step1/3/5 read-only guidance), scoringNotes
*/
const FAMILIES = {

"P1-2": {
  paper:"Paper 1", marks:2, label:"2-mark identify / define / state",
  cmdterms:["Identify","Define","State","Outline"],
  sampleQ:{
    title:"Specimen-style: identify",
    text:"Identify two characteristics of a recommender system used by a streaming platform.",
    hint:"Short-answer. Two crisp, distinct points. Do NOT write paragraphs."
  },
  mscheme:[
    "Award [1] per valid distinct point, up to [2].",
    "OR award [1] for identifying a feature + [1] for a brief development of the same feature.",
    "Accurate, precise terminology is rewarded; vague restatement is not."
  ],
  nonneg:[
    "Two distinct points — OR one point with a brief development.",
    "Uses accurate Digital Society / subject-specific terminology.",
    "Does not drift into explanation, discussion, or evaluation."
  ],
  testing:"Basic recall and accurate use of DS terminology. Can the student name two distinct, relevant features?",
  cmdFocus:"Identify / State / Define = name it. No 'because'. No development beyond the one-clause clarifier.",
  weak:["Gives one point twice in different words.","Vague phrases like 'it helps people' with no feature named.","Writes a paragraph explaining why it matters — wasted time, no extra marks."],
  strong:["Names two genuinely different features using precise terms.","Uses correct DS vocabulary (algorithm, data, filtering, etc.) without over-reaching.","Keeps each point to one tight sentence."],
  exMind:[
    "Notices the command term first — identify means list and name, not explain.",
    "Checks the mark value: 2 marks = 2 distinct points (or 1 + development).",
    "Brainstorms 3–4 candidate features and picks the two most clearly different.",
    "Uses subject-specific vocabulary on the first attempt."
  ],
  exCmd:"Identify / State / Define / Outline are low-stakes command terms. The examiner is checking vocabulary and recall, not reasoning. Two sharp noun-phrases outperform two sentences.",
  exSrc:"Not source-based in Paper 1 short questions. If a stimulus is referenced, use terminology from it — but do not quote.",
  exTraps:["Writing a mini-essay.","Two points that are the same idea reworded.","Using everyday words where DS terms exist ('the thing that picks stuff' vs 'content recommendation algorithm')."],
  exPlan:["Two genuinely different features.","Correct DS vocabulary for each.","A one-sentence structure for each point."],
  preChecklist:[
    {id:"p1",text:"I read the command term carefully."},
    {id:"p2",text:"I have two genuinely different points in mind."},
    {id:"p3",text:"I know the DS term I will use for each."}
  ],
  brainFields:[
    {id:"point1",label:"Point 1 (short phrase)",ph:"e.g., collaborative filtering algorithm",rows:1},
    {id:"point2",label:"Point 2 (short phrase) — must be different from Point 1",ph:"e.g., personalised user profile built from watch history",rows:1},
    {id:"dev",label:"Optional brief clarifier (only if one point)",ph:"If you only have one point, a brief mechanism clarifier can earn [1].",rows:1}
  ],
  postChecklist:[
    {id:"q1",text:"I identified two distinct valid points.",weight:2,cap:null},
    {id:"q2",text:"I used accurate DS terminology.",weight:1,cap:1},
    {id:"q3",text:"I avoided vague generalisations and restatement.",weight:1,cap:1},
    {id:"q4",text:"Each point is clear in one sentence.",weight:1,cap:null}
  ],
  stamps:["DEF","EV","LINK"],
  rubric:[
    {lvl:"2 marks",m:"2",cls:"top",d:"Two distinct valid points OR one point with a developed clarifier; precise terminology."},
    {lvl:"1 mark",m:"1",cls:"mid",d:"One valid point, or two points that are not genuinely distinct."},
    {lvl:"0 marks",m:"0",cls:"low",d:"No valid point, or restatement of the question without DS content."}
  ],
  rubricSrc:"Pattern from specimen Paper 1 SL markscheme — [1] per identified point, up to [2]."
},

"P1-4": {
  paper:"Paper 1", marks:4, label:"4-mark explain / describe",
  cmdterms:["Explain","Describe","Outline"],
  sampleQ:{
    title:"Specimen-style: explain",
    text:"Explain two reasons why personal data collected by social media platforms may pose risks to users.",
    hint:"Two distinct reasons, each developed with a mechanism or consequence. [2] + [2]."
  },
  mscheme:[
    "Award [1] per identified reason / way / risk (up to 2).",
    "Award [1] per development (mechanism or consequence) of that reason (up to 2).",
    "Total [4]: pattern is [2] + [2] — two reasons each developed."
  ],
  nonneg:[
    "Two distinct reasons / ways — not one reason twice.",
    "Each reason is developed with a mechanism (how) OR a consequence (so what).",
    "Uses accurate DS terminology; avoids vague generic phrasing."
  ],
  testing:"Whether the student can give two distinct reasons AND show development — the step up from 'identify'. Listing ≠ explaining.",
  cmdFocus:"Explain / Describe = identify PLUS develop. The development is the mechanism (how it works) or the consequence (what it leads to).",
  weak:["Lists two reasons with no development — caps at 2.","Writes the same reason twice using different words.","Gives description instead of explanation (what happens, not why/how)."],
  strong:["Two distinct reasons, each paired with a clear mechanism-or-consequence.","Uses precise DS vocabulary.","Each point reads as identify → because/therefore/this means → specific consequence."],
  exMind:[
    "Reads the command term, then looks for the noun phrase (two reasons / two ways / two risks).",
    "Brainstorms 3–4 reasons, picks the two most distinct and most developable.",
    "Plans the development for each before writing: is it mechanism (how) or consequence (so what)?",
    "Drafts each point as one tight sentence or two short ones."
  ],
  exCmd:"Explain / Describe means identify + develop. Development is the difference between 2/4 and 4/4. A mechanism shows how; a consequence shows so-what.",
  exSrc:"Not source-based, but can reference specific examples (companies, technologies, policies) to anchor the development.",
  exTraps:["'Listing trap' — two reasons, no development.","'Twin trap' — two reasons that are really the same idea.","Vague scaremongering ('bad things could happen')."],
  exPlan:["Two distinct reasons.","One development sentence per reason.","Specific DS terms per reason."],
  preChecklist:[
    {id:"p1",text:"I have two distinct reasons (not the same idea twice)."},
    {id:"p2",text:"I have planned a development (mechanism or consequence) for each."},
    {id:"p3",text:"I know the DS terminology I will use."}
  ],
  brainFields:[
    {id:"point1",label:"Reason / way 1",ph:"Short phrase — what is the risk/reason?",rows:1},
    {id:"dev1",label:"Development 1 — mechanism (how) or consequence (so what)",ph:"Keywords only — not a finished sentence.",rows:2},
    {id:"point2",label:"Reason / way 2 (must be distinct from 1)",ph:"Short phrase",rows:1},
    {id:"dev2",label:"Development 2 — mechanism or consequence",ph:"Keywords only.",rows:2}
  ],
  postChecklist:[
    {id:"q1",text:"I identified two distinct reasons / ways.",weight:2,cap:2},
    {id:"q2",text:"I developed each reason with a mechanism or consequence.",weight:2,cap:2},
    {id:"q3",text:"I used accurate DS terminology throughout.",weight:1,cap:null},
    {id:"q4",text:"I avoided vague / generic points.",weight:1,cap:null}
  ],
  stamps:["DEF","EV","IMP","LINK"],
  rubric:[
    {lvl:"Top (4)",m:"4",cls:"top",d:"Two distinct reasons, each developed with a clear mechanism or consequence; precise terminology."},
    {lvl:"Developed (3)",m:"3",cls:"good",d:"Two reasons, one fully developed; or two reasons both briefly developed but with a lapse."},
    {lvl:"Partial (2)",m:"2",cls:"mid",d:"Two valid but undeveloped points (listing), OR one reason well developed."},
    {lvl:"Limited (1)",m:"1",cls:"low",d:"One partial point; inconsistent terminology."},
    {lvl:"No mark (0)",m:"0",cls:"low",d:"No valid point or restatement only."}
  ],
  rubricSrc:"Pattern from specimen Paper 1 SL markscheme — [2] + [2]: identify + development for each of two points."
},

"P1-6": {
  paper:"Paper 1", marks:6, label:"6-mark analyse",
  cmdterms:["Analyse","Examine"],
  sampleQ:{
    title:"Specimen-style: analyse",
    text:"Analyse the impact of facial recognition technology on public spaces.",
    hint:"Go beyond description. Break the impact into causes/consequences. Use at least one specific example; attempt synthesis."
  },
  mscheme:[
    "1–2: specific points identified; lacks direct analysis; description at most.",
    "3–4: impacts outlined/described; some analysis; reference to an example or similar case.",
    "5–6: impacts analysed in depth; developed range of points; explicit example reference; attempt at synthesis."
  ],
  nonneg:[
    "Analysis, not description (explain how/why each impact arises, not just what happens).",
    "A specific example or case reference to ground the analysis.",
    "A range of developed points (at least 2 analysed in depth, ideally 3).",
    "Accurate, precise DS terminology used purposefully."
  ],
  testing:"Whether the student can decompose an issue into causes and consequences, anchor analysis in an example, and synthesise — rather than merely describe.",
  cmdFocus:"Analyse = break it down. For each impact: what causes it, how it manifests, who it affects, and why it matters. Ends with synthesis, not a summary.",
  weak:["Describes the technology instead of analysing impact.","One developed point; rest are listed.","No example — purely abstract.","Vocabulary used imprecisely (e.g., 'data' where 'biometric data' is needed)."],
  strong:["Each point shows cause → mechanism → consequence.","At least one specific, named example ties the analysis to the real world.","Uses DS terms precisely and purposefully.","Ends with a short synthesis of how the impacts interact."],
  exMind:[
    "Maps the issue onto 3Cs (content, context, concept) quickly.",
    "Picks 2–3 impacts that can be analysed in depth, not 5 that will be listed.",
    "Chooses a specific example before writing — a case, policy, or platform.",
