    }
    e.target.value = "";
  });
  $("#btnReset").addEventListener("click",()=> $("#resetModal").classList.add("vis"));
  $("#confirmReset").addEventListener("click",()=>{
    state.data={};
    localStorage.removeItem(stateKey());
    $("#resetModal").classList.remove("vis");
    renderAll();
  });
  // close any modal on outer click or Cancel button
  document.addEventListener("click",e=>{
    if(e.target.classList && e.target.classList.contains("modal-bg")){ e.target.classList.remove("vis"); }
    if(e.target.tagName==="BUTTON" && e.target.textContent==="Cancel"){
      e.target.closest(".modal-bg").classList.remove("vis");
    }
  });
  // custom save/clear
  $("#cSave").addEventListener("click",()=>{
    const title=$("#cTitle").value.trim();
    const text=$("#cText").value.trim();
    const anchors=$("#cAnchors").value.split(/\n+/).map(s=>s.trim()).filter(Boolean);
    const nonneg=$("#cNonneg").value.split(/\n+/).map(s=>s.trim()).filter(Boolean);
    if(!text){ alert("Please paste the question text."); return; }
    state.custom = {title,text,anchors,nonneg};
    localStorage.setItem(LS_CUSTOM+state.famKey, JSON.stringify(state.custom));
    // switch data bucket since stateKey depends on custom
    const d = localStorage.getItem(stateKey());
    state.data = d ? JSON.parse(d) : {};
    $("#customModal").classList.remove("vis");
    renderAll();
  });
  $("#cClear").addEventListener("click",()=>{
    state.custom=null;
    localStorage.removeItem(LS_CUSTOM+state.famKey);
    const d = localStorage.getItem(stateKey());
    state.data = d ? JSON.parse(d) : {};
    $("#customModal").classList.remove("vis");
    renderAll();
  });
  // copy AI prompt
  $("#copyBtn").addEventListener("click",()=>{
    const txt=$("#promptBox").textContent;
    navigator.clipboard.writeText(txt).then(()=>{
      const b=$("#copyBtn");
      b.classList.add("done");
      b.textContent="Copied ✓";
      setTimeout(()=>{b.classList.remove("done"); b.textContent="Copy prompt to clipboard";},1800);
    });
  });
  // teacher log
  $("#addTeachRow").addEventListener("click",()=>{
    state.data.teacher = state.data.teacher || {rows:[],final:"",comment:""};
    state.data.teacher.rows.push({quote:"",issue:"",reason:"",next:"",mark:""});
    renderStep8(); queueSave();
  });
  // export json
  $("#exportJson").addEventListener("click",()=>{
    const payload = {
      family: state.famKey,
      familyLabel: fam().label,
      custom: state.custom,
      question: activeQuestion(),
      markscheme: activeMScheme(),
      nonNegotiables: activeNonneg(),
      data: state.data,
      scoring: computeScore(),
      exportedAt: new Date().toISOString()
    };
    download("digsoc_session_"+state.famKey+".json", JSON.stringify(payload,null,2), "application/json");
  });
  $("#exportTxt").addEventListener("click",()=>{
    const f=fam(); const q=activeQuestion(); const s=computeScore();
    const brain=state.data.brain||{}; const post=state.data.post||{}; const emap=state.data.emap||[]; const t=state.data.teacher||{rows:[],final:"",comment:""};
    const md=[];
    md.push("# IB Digital Society · Response Report");
    md.push("");
    md.push("**Family:** "+f.paper+" — "+f.label+" ("+f.marks+" marks)");
    md.push("**Question:** "+(q.title||"")+"\n\n> "+q.text);
    md.push("");
    md.push("## Markscheme anchors");
    activeMScheme().forEach(a=>md.push("- "+a));
    md.push("");
    md.push("## Non-negotiables");
    activeNonneg().forEach(n=>md.push("- "+n));
    md.push("");
    md.push("## Brainstorm");
    f.brainFields.forEach(fld=>md.push("**"+fld.label+":** "+(brain[fld.id]||"(blank)")));
    md.push("");
    md.push("## Response");
    md.push("");
    md.push(state.data.response||"(blank)");
    md.push("");
    md.push("## Evidence map");
    if(emap.length) emap.forEach(r=>md.push(`- **[${r.stamp}]** "${r.quote||""}" — ${r.note||""}`));
    else md.push("(none)");
    md.push("");
    md.push("## Self-assessment checklist");
    f.postChecklist.forEach(i=>md.push(`- [${post[i.id]?"x":" "}] ${i.text}`));
    md.push("");
    md.push("## Provisional score: **"+s.score+" / "+s.total+"** · "+bandForScore(s.score,s.total).name);
    md.push("_Provisional estimate based on self-identified evidence — not a final IB mark._");
    if(s.capsApplied.filter(c=>!c.silent).length){
      md.push("");
      md.push("**Hard caps applied:**");
      s.capsApplied.filter(c=>!c.silent).forEach(c=>md.push("- "+c.text+" → cap "+c.cap));
    }
    md.push("");
    md.push("## Teacher evidence log");
    t.rows.forEach(r=>{
      if(r.quote||r.issue||r.reason||r.next||r.mark){
        md.push(`- **Quote:** "${r.quote||""}" · **Issue:** ${r.issue||""} · **Rubric reason:** ${r.reason||""} · **Next step:** ${r.next||""} · **Mark:** ${r.mark||""}`);
      }
    });
    if(t.final)   md.push("**Final teacher mark:** "+t.final);
    if(t.comment) md.push("**Teacher comment:** "+t.comment);
    md.push("");
    md.push("_Generated by DigSoc Response Studio on "+new Date().toLocaleString()+"_");
    download("digsoc_report_"+state.famKey+".md", md.join("\n"), "text/markdown");
  });
  $("#exportQuestionPack").addEventListener("click",()=>{
    const pack = buildQuestionPack();
    const base = (pack.customQuestion.title || "question_pack").toLowerCase().replace(/[^a-z0-9]+/g,"_").replace(/^_|_$/g,"");
    download((base || "question_pack")+".json", JSON.stringify(pack,null,2), "application/json");
  });

  $("#clearThis").addEventListener("click",()=>{
    if(confirm("Clear all saved work for this question? Teacher notes included.")){
      state.data={};
      localStorage.removeItem(stateKey());
      renderAll();
    }
  });

  // initial render
  renderAll();
  // render AI prompt block initially
  renderStep7();
});

function openCustom(){
  const m=$("#customModal");
  $("#cTitle").value   = state.custom?.title||"";
  $("#cText").value    = state.custom?.text||"";
  $("#cAnchors").value = (state.custom?.anchors||[]).join("\n");
  $("#cNonneg").value  = (state.custom?.nonneg||[]).join("\n");
  m.classList.add("vis");
}

function download(name, content, mime){
  const blob=new Blob([content],{type:mime});
  const url=URL.createObjectURL(blob);
  const a=document.createElement("a");
  a.href=url; a.download=name; document.body.appendChild(a); a.click();
  setTimeout(()=>{URL.revokeObjectURL(url); a.remove();},500);
}

</script>
<script>
/* =========================================================
   Command-term adaptive overlay (retrofit)
   Detects which of the 17 IB DS command terms appears in the
   current question text (seeded OR custom) and overlays
   term-specific guidance into Step 1 and Step 2 without
   modifying the existing FAMILIES rubric logic.
   ========================================================= */
(function(){
  const COMMAND_TERMS = {
    identify: {
      label:"Identify", bloom:"AO1", band:"Recall",
      asks:"Provide an answer from a number of possibilities — no explanation needed.",
      does:["Name two or more things.","Use DS terminology.","Keep answers short (noun phrases)."],
      doesnt:["Explain or develop.","Argue for a position.","Write full analytical sentences."],
      typicalMarks:[1,2,3],
      strongExample:"Two features are (a) collaborative filtering; (b) implicit feedback.",
      weakTrap:"Writing a paragraph when the question wants two noun phrases — wasted time, no extra marks."
    },
    state: {
      label:"State", bloom:"AO1", band:"Recall",
      asks:"Give a specific name, value, or other brief answer without explanation.",
      does:["Answer directly.","Use precise terminology.","Keep it brief."],
      doesnt:["Explain mechanism.","Give context.","List alternatives."],
      typicalMarks:[1,2],
      strongExample:"The term is metadata.",
      weakTrap:"Adding explanation that isn't scored."
    },
    define: {
      label:"Define", bloom:"AO1", band:"Terminology",
      asks:"Give the precise meaning of a word, phrase, concept, or quantity.",
      does:["Use the concept's standard definition.","Include distinguishing features.","One sentence if possible."],
      doesnt:["Give examples instead of a definition.","Describe how the thing is used."],
      typicalMarks:[1,2],
      strongExample:"Metadata: data that describes other data (e.g., timestamp, location, author).",
      weakTrap:"Describing the technology instead of defining the term."
    },
    describe: {
      label:"Describe", bloom:"AO1", band:"Descriptive",
      asks:"Give a detailed account without explanation or judgement.",
      does:["Name features.","Sketch how the thing looks or works at surface level.","Use DS terminology."],
      doesnt:["Evaluate.","Argue a position.","Compare unless asked."],
      typicalMarks:[2,4],
      strongExample:"A filter bubble is an online environment where algorithms show a user content matching their prior engagement, narrowing exposure to diverse views.",
      weakTrap:"Drifting into evaluation or personal opinion — description only."
    },
    outline: {
      label:"Outline", bloom:"AO1", band:"Descriptive",
      asks:"Give a brief summary of the main points.",
      does:["Cover the main features.","Keep each point short.","Use structure (two or three points)."],
      doesnt:["Go deep on one point.","Include extensive examples."],
      typicalMarks:[2,4],
      strongExample:"Two key features: (1) targeted advertising based on behavioural data; (2) engagement-optimised feed ranking.",
      weakTrap:"Writing a full paragraph when brevity is what's scored."
    },
    explain: {
      label:"Explain", bloom:"AO2", band:"Developmental",
      asks:"Give a detailed account including reasons or causes — not just what, but why / how.",
      does:["State the point.","Develop with mechanism (how) OR consequence (why it matters).","Use cause → effect language."],
      doesnt:["Just describe.","List without developing.","Evaluate."],
      typicalMarks:[3,4,6],
      strongExample:"Collaborative filtering narrows exposure because the algorithm prioritises items that similar users have engaged with; dissenting content with low engagement is systematically down-ranked, reducing diversity of exposure.",
      weakTrap:"Listing two points without developing either — caps at half marks."
    },
    suggest: {
      label:"Suggest", bloom:"AO3", band:"Applied reasoning",
      asks:"Propose a solution, hypothesis, or possible answer.",
      does:["Offer plausible options.","Justify briefly.","Use DS concepts to frame the suggestion."],
      doesnt:["State as fact.","Ignore alternatives.","Write without reasoning."],
      typicalMarks:[2,4,6],
      strongExample:"One solution would be mandated algorithmic audits, because independent review can detect discriminatory patterns that internal reviews miss.",
      weakTrap:"Suggesting without justifying — looks like opinion, not reasoning."
    },
    distinguish: {
      label:"Distinguish", bloom:"AO2", band:"Comparative",
      asks:"Make clear the differences between two or more concepts or items.",
      does:["Name both items.","Name the axis/axes of difference.","Use same-axis comparison."],
      doesnt:["Just describe both in parallel.","Skip the 'whereas' / 'in contrast' logic."],
      typicalMarks:[2,4],
      strongExample:"Data is raw facts; information is data that has been processed and given context. A timestamp is data; a timestamped police-activity heatmap is information.",
      weakTrap:"Two parallel descriptions with no comparative language."
    },
    analyse: {
      label:"Analyse", bloom:"AO3", band:"Analytical",
      asks:"Break an issue into parts and examine relationships, causes, mechanisms, and consequences.",
      does:["Decompose the issue.","Show cause → mechanism → consequence.","Anchor in specific examples.","Identify who is affected."],
      doesnt:["Just describe.","List without depth.","Generalise without evidence."],
      typicalMarks:[6,8],
      strongExample:"The impact operates via three mechanisms: attention capture through variable-reward design; social-comparison amplification via like-metrics; algorithmic curation reinforcing negative affect — documented in the Haugen disclosures (2021).",
      weakTrap:"Description dressed as analysis — no mechanism, no consequence chain."
    },
    examine: {
      label:"Examine", bloom:"AO3", band:"Evaluative",
      asks:"Consider an argument or concept to reveal assumptions and interrelationships.",
      does:["Surface the assumptions behind a claim.","Identify internal tensions.","Consider multiple angles."],
      doesnt:["Take a single position only.","Describe without probing.","Skip counter-perspectives."],
      typicalMarks:[6,8],
      strongExample:"Examining the claim that 'AI is neutral' surfaces three hidden assumptions: training data is representative, design choices are value-free, and deployment contexts don't shape effect. Each, on inspection, is contested.",
      weakTrap:"Treating 'examine' as a synonym for 'describe'."
    },
    discuss: {
      label:"Discuss", bloom:"AO3", band:"Evaluative (balanced)",
      asks:"Offer a considered, balanced review covering a range of arguments, factors, or hypotheses.",
      does:["Present multiple perspectives.","Weigh arguments on different sides.","Use evidence to support each side.","Reach a considered conclusion (judgement less forced than in 'to what extent')."],
      doesnt:["Take a one-sided position.","List without balance.","Ignore counter-arguments."],
      typicalMarks:[8,12],
      strongExample:"On one hand, generative AI democratises creative expression. On the other, it erodes attribution and trust in human authorship. The balance depends on detection infrastructure and norms around disclosure.",
      weakTrap:"Advocating instead of discussing — becomes persuasive, not balanced."
    },
    evaluate: {
      label:"Evaluate", bloom:"AO3", band:"Evaluative (judgement)",
      asks:"Make an appraisal by weighing strengths and limitations.",
      does:["Identify strengths with evidence.","Identify limitations with evidence.","Make an overall judgement.","Justify the judgement."],
      doesnt:["Just list strengths and limitations without a judgement.","Give opinion without evidence."],
      typicalMarks:[8,12],
      strongExample:"Collaborative filtering's strengths include personalisation and scale; its limitations include filter bubbles and bias amplification. On balance, the limitations outweigh the benefits for news contexts, though the judgement reverses for lower-stakes domains like music.",
      weakTrap:"Listing pros and cons without reaching an evaluative judgement."
    },
    "to what extent": {
      label:"To what extent", bloom:"AO3", band:"Evaluative (scale)",
      asks:"Consider the merits of a case or argument — the answer is rarely 'fully' or 'not at all'.",
      does:["State the degree of agreement.","Support with evidence for and against.","Anchor the judgement to conditions (who, when, with what safeguards).","Reach a conditional conclusion."],
      doesnt:["Flat yes or no.","Ignore the scale.","Skip conditions on the judgement."],
      typicalMarks:[8,12],
      strongExample:"To a significant extent, algorithmic personalisation harms democratic discourse — but only where platforms lack content-neutral ranking options and regulators lack audit access.",
      weakTrap:"Answering 'yes it does' or 'no it doesn't' without nuance."
    },
    justify: {
      label:"Justify", bloom:"AO3", band:"Evaluative (position)",
      asks:"Give valid reasons or evidence to support an answer or conclusion.",
      does:["State the position clearly.","Provide reasoned support.","Address likely objections."],
      doesnt:["Assert without evidence.","Ignore counter-arguments.","Rely on opinion only."],
      typicalMarks:[6,8],
      strongExample:"Regulators should mandate algorithmic transparency in hiring because (1) affected parties cannot otherwise contest unfair outcomes; (2) case precedent (Amazon, 2018) shows internal review is insufficient; (3) the regulatory burden is modest relative to the harm.",
      weakTrap:"Stating a position without the 'because' chain — no marks for assertion alone."
    },
    compare: {
      label:"Compare", bloom:"AO2", band:"Comparative",
      asks:"Give an account of the similarities between two or more items or situations.",
      does:["Use same-axis comparison.","Name shared features.","Use 'both', 'similarly', 'like'."],
      doesnt:["Describe them in parallel with no connective logic.","Drift into difference unless asked."],
      typicalMarks:[4,6],
      strongExample:"Both Source C and Source D highlight the power asymmetry between platforms and users: C via data-extraction framing, D via terms-of-service complexity.",
      weakTrap:"Two parallel summaries with no explicit similarity statement."
    },
    contrast: {
      label:"Contrast", bloom:"AO2", band:"Comparative",
      asks:"Give an account of the differences between two or more items or situations.",
      does:["Use same-axis contrast.","Name the dimension of difference.","Use 'however', 'whereas', 'in contrast'."],
      doesnt:["Describe both with no contrast markers.","List similarities instead."],
      typicalMarks:[4,6],
      strongExample:"Source C frames data practices as extractive, whereas Source D frames them as transactional — the difference turns on whether consent is treated as meaningful.",
      weakTrap:"Two parallel descriptions with no explicit difference statement."
    },
    "compare and contrast": {
      label:"Compare and contrast", bloom:"AO2–AO3", band:"Comparative (integrated)",
      asks:"Give an account of BOTH similarities and differences between two or more items or situations.",
      does:["Include at least one similarity AND one difference.","Use same-point comparison (not source-by-source summary).","Explicitly reference each source / item."],
      doesnt:["Only list similarities.","Only list differences.","Summarise each source separately."],
      typicalMarks:[6,8],
      strongExample:"Both sources identify platform power as the core issue (similarity), but C locates the power in data extraction while D locates it in contract design (difference) — pointing to different regulatory responses.",
      weakTrap:"Only doing half the task — caps low if only similarities OR only differences."
    }
  };

  /* Multi-word first, then longer single words, then short ones. */
  const TERM_PRIORITY = [
    "compare and contrast","to what extent",
    "analyse","analyze","evaluate","discuss","examine","justify","distinguish",
    "describe","explain","outline","suggest","identify","compare","contrast",
    "define","state"
  ];
  const TERM_ALIASES = { "analyze":"analyse" };

  function detectCommandTerm(text){
    if(!text) return null;
    const t = " "+text.toLowerCase().replace(/[^a-z\s]+/g," ")+" ";
    for(const term of TERM_PRIORITY){
      const re = new RegExp("(?:^|\\W)"+term.replace(/ /g,"\\s+")+"(?:\\W|$)","i");
      if(re.test(t)){
        const key = TERM_ALIASES[term] || term;
        if(COMMAND_TERMS[key]) return key;
      }
    }
    return null;
  }

  function ensureDom(){
    const p1 = document.getElementById("p1");
    const p2 = document.getElementById("p2");
    if(p1 && !document.getElementById("ctOverlay")){
      const card = document.createElement("div");
      card.id = "ctOverlay";
      card.className = "card";
      card.style.cssText = "border-left:3px solid #7cc4ff;margin-top:12px;display:none";
      const qtextCard = (document.getElementById("qtext")||{}).closest ? document.getElementById("qtext").closest(".card") : null;
      if(qtextCard && qtextCard.parentNode){
        qtextCard.parentNode.insertBefore(card, qtextCard.nextSibling);
      } else {
        p1.appendChild(card);
      }
    }
    if(p2 && !document.getElementById("ctStep2")){
      const card = document.createElement("div");
      card.id = "ctStep2";
      card.className = "card";
      card.style.cssText = "border-left:3px solid #7cc4ff;display:none;margin-bottom:12px";
      const title = p2.querySelector(".ptitle");
      const afterSub = title && title.nextElementSibling;
      p2.insertBefore(card, afterSub ? afterSub.nextSibling : (title ? title.nextSibling : p2.firstChild));
    }
  }

  function getFamilyCmdTerms(){
    const qhead = document.getElementById("qhead");
    if(!qhead) return [];
    const chips = qhead.querySelectorAll(".chip");
    for(const chip of chips){
      const m = chip.textContent.match(/command:\s*(.+)/i);
      if(m) return m[1].split(/\s*\/\s*/).map(s=>s.toLowerCase().trim());
    }
    return [];
  }

  function escHtml(s){ return (s||"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"})[c]); }

  function render(){
    ensureDom();
    const qtext = document.getElementById("qtext");
    const text = qtext ? qtext.textContent : "";
    const term = detectCommandTerm(text);
    const ov = document.getElementById("ctOverlay");
    const s2 = document.getElementById("ctStep2");
    if(!term){
      if(ov) ov.style.display = "none";
      if(s2) s2.style.display = "none";
      return;
    }
    const T = COMMAND_TERMS[term];
    const famTerms = getFamilyCmdTerms();
    const matchFam = famTerms.some(ft => ft.includes(term) || term.includes(ft));
    const mismatchMsg = (!matchFam && famTerms.length)
      ? `<div style="margin-top:8px;background:#3a2a12;border:1px solid #6b4a1c;color:#ffdca7;padding:8px 10px;border-radius:6px;font-size:12.5px">
          <strong>Heads-up:</strong> the question uses <em>${escHtml(T.label)}</em>, but the question family expects <em>${famTerms.map(escHtml).join(" / ")}</em>.
          Trust the verb in the question — follow the <em>${escHtml(T.label)}</em> pattern below.
        </div>` : "";
    if(ov){
      ov.style.display = "";
      ov.innerHTML = `
        <h3 style="margin:0 0 6px 0">Detected command term:
          <span style="background:#7cc4ff;color:#06222f;padding:2px 8px;border-radius:4px;font-weight:700">${escHtml(T.label)}</span>
          <span style="color:#9fb0c3;font-weight:500;font-size:12px">· ${escHtml(T.bloom)} · ${escHtml(T.band)} · typically ${T.typicalMarks.join(" / ")} marks</span>
        </h3>
        <p style="margin:4px 0"><strong>What it asks:</strong> ${escHtml(T.asks)}</p>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:6px">
          <div><strong>Do</strong><ul style="margin:2px 0;padding-left:18px">${T.does.map(x=>`<li>${escHtml(x)}</li>`).join("")}</ul></div>
          <div><strong>Don't</strong><ul style="margin:2px 0;padding-left:18px">${T.doesnt.map(x=>`<li>${escHtml(x)}</li>`).join("")}</ul></div>
        </div>
        ${mismatchMsg}
      `;
    }
    if(s2){
      s2.style.display = "";
      s2.innerHTML = `
        <h3 style="margin:0 0 6px 0">How to read <em>${escHtml(T.label)}</em> before writing</h3>
        <p style="margin:4px 0"><strong>The exemplar's rule:</strong> ${escHtml(T.asks)}</p>
        <p style="margin:4px 0"><strong>What a strong response sounds like:</strong><br><em>"${escHtml(T.strongExample)}"</em></p>
        <p style="margin:4px 0"><strong>The trap to avoid:</strong> ${escHtml(T.weakTrap)}</p>
      `;
    }
  }

  function init(){
    ensureDom();
    render();
    const qtext = document.getElementById("qtext");
    const qhead = document.getElementById("qhead");
    const obs = new MutationObserver(render);
    if(qtext) obs.observe(qtext, {childList:true, characterData:true, subtree:true});
    if(qhead) obs.observe(qhead, {childList:true, characterData:true, subtree:true});
  }
  if(document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
  else init();
})();
</script>
